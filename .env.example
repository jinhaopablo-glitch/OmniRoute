# =============================================================================
# PUAVI AI · Variables de entorno (EJEMPLO, sin valores reales)
# Cada proceso recibe SOLO su bloque. NUNCA subas valores reales al repositorio.
# =============================================================================

# ---------------------------------------------------------------------------
# 1) WORKER DE AGENTES  (app Fly "puavi-agents")  — solo lectura
#    El worker se niega a arrancar si encuentra variables del bloque 2.
# ---------------------------------------------------------------------------
PUAVI_AGENT_DB_URL=            # usuario puavi_agent_login
PUAVI_SUPERVISOR_DB_URL=       # usuario puavi_supervisor_login
ANTHROPIC_API_KEY=
SHOPIFY_STORE_DOMAIN=          # tutienda.myshopify.com
SHOPIFY_READ_TOKEN=            # app de Shopify SOLO lectura
SHOPIFY_API_VERSION=2026-10
META_READ_TOKEN=               # token con instagram_basic + instagram_manage_insights
INSTAGRAM_USER_ID=
META_GRAPH_API_VERSION=v23.0
TIKTOK_READ_TOKEN=             # scopes de lectura (user.info.stats)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
PUAVI_STORAGE_EMAIL=           # usuario técnico de Storage (sin perfil)
PUAVI_STORAGE_PASSWORD=
PUAVI_WORKER_ID=worker-1

# ---------------------------------------------------------------------------
# 2) EJECUTOR  (app Fly "puavi-executor")  — único con permisos de escritura
# ---------------------------------------------------------------------------
PUAVI_EXECUTOR_DB_URL=         # usuario puavi_executor_login
PUAVI_EXECUTOR_DRY_RUN=true    # pon false cuando quieras que actúe de verdad
SHOPIFY_STORE_DOMAIN=
SHOPIFY_WRITE_TOKEN=           # app de Shopify con write_products
META_ACCESS_TOKEN=             # instagram_content_publish (+ ads_management si usas anuncios)
INSTAGRAM_USER_ID=
META_AD_ACCOUNT_ID=            # sin el prefijo act_ (opcional)
TIKTOK_ACCESS_TOKEN=           # video.upload (borradores) o video.publish
TIKTOK_POST_MODE=inbox         # inbox = borrador en tu app de TikTok | direct
BREVO_API_KEY=                 # opcional, emails comerciales
BREVO_SENDER_EMAIL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
PUAVI_STORAGE_EMAIL=           # puede ser otro usuario técnico de solo lectura
PUAVI_STORAGE_PASSWORD=

# ---------------------------------------------------------------------------
# 3) PANEL  (Cloudflare Pages) — valores públicos por diseño; la RLS protege
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# La service_role key de Supabase NO se usa en ningún sitio.

# --- Solo tests --------------------------------------------------------------
# PUAVI_TEST_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/postgres
# PUAVI_LOCAL_MEDIA_DIR=./media-cache
