# =============================================================================
# PUAVI AI · Variables de entorno (EJEMPLO, sin valores reales)
# Copia lo que necesite cada proceso en su gestor de secretos del hosting.
# NUNCA subas un .env con valores al repositorio.
# =============================================================================

# --- Comunes ---------------------------------------------------------------
PUAVI_ENV=development
PUAVI_LOG_LEVEL=INFO

# --- Proceso WORKER DE AGENTES (solo lectura) -------------------------------
# Usuario de Postgres que hereda de puavi_agent / puavi_supervisor.
PUAVI_AGENT_DB_URL=
PUAVI_SUPERVISOR_DB_URL=
ANTHROPIC_API_KEY=
SHOPIFY_STORE_DOMAIN=
# Token de una app de Shopify con scopes SOLO de lectura.
SHOPIFY_READ_TOKEN=
PUAVI_WORKER_ID=worker-1

# --- Proceso EJECUTOR (único con permisos de escritura) ---------------------
# El worker de agentes se niega a arrancar si encuentra estas variables.
PUAVI_EXECUTOR_DB_URL=
PUAVI_EXECUTOR_DRY_RUN=true
PUAVI_EXECUTOR_POLL_SECONDS=30
SHOPIFY_WRITE_TOKEN=
META_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# --- Panel (Fase 1) ----------------------------------------------------------
# La clave anon es pública por diseño; la seguridad la impone la RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# La service_role key NO se usa en ningún proceso de PUAVI.

# --- Solo tests -------------------------------------------------------------
# PUAVI_TEST_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/postgres
